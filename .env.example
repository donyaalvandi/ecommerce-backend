# =====================
# Environment
# =====================
NODE_ENV=development
PORT=3000

# =====================
# Database
# =====================
DATABASE_URL="file:./dev.db"

# =====================
# JWT
# =====================
JWT_SECRET=your_secret_key_here
JWT_EXPIRES_IN=7d

# =====================
# Uploads
# =====================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=2097152
